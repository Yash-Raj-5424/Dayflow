DATABASE_URL=postgresql+psycopg2://apple@localhost:5432/dayflow
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Gmail SMTP — requires 2-Step Verification enabled on the account and an
# App Password (16 chars, no spaces) generated at
# https://myaccount.google.com/apppasswords
# If SMTP_USERNAME/SMTP_PASSWORD are left blank, verification emails are
# logged to the console instead of being sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Dayflow

# Where the "Verify Email" button in the email points — the frontend's
# own URL. It builds a link as {FRONTEND_URL}/verify-email?token=...
FRONTEND_URL=http://localhost:5173
